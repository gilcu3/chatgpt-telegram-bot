# Your Anthropic API key
ANTHROPIC_API_KEY=XXX

# Your Telegram bot token obtained using @BotFather
TELEGRAM_BOT_TOKEN=XXX

# Telegram user ID of admins, or - to assign no admin
ADMIN_USER_IDS=ADMIN_1_USER_ID,ADMIN_2_USER_ID

# Comma separated list of telegram user IDs, or * to allow all
ALLOWED_TELEGRAM_USER_IDS=USER_ID_1,USER_ID_2

# Optional configuration
# BUDGET_PERIOD=monthly
# USER_BUDGETS=*
# GUEST_BUDGET=100.0
# TOKEN_PRICE=0.003
# VISION_TOKEN_PRICE=0.003
# ENABLE_QUOTING=true
# ENABLE_VISION=true
# PROXY=http://localhost:8080
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# ASSISTANT_PROMPT="You are a helpful assistant."
# SHOW_USAGE=false
# STREAM=true
# TELEGRAM_NATIVE_STREAM=false
# MAX_TOKENS=4096
# VISION_MAX_TOKENS=300
# MAX_HISTORY_SIZE=15
# MAX_CONVERSATION_AGE_MINUTES=180
# VISION_PROMPT="What is in this image"
# TEMPERATURE=1.0
# GROUP_TRIGGER_KEYWORD=""
# GROUP_CONTEXT_MESSAGES=5
# IGNORE_GROUP_VISION=true
# BOT_LANGUAGE=en
# ENABLE_VISION_FOLLOW_UP_QUESTIONS=true

# Smart model routing (auto-select Haiku/Sonnet/Opus based on complexity)
# ENABLE_SMART_ROUTING=false
# ROUTING_HAIKU_MODEL=claude-haiku-4-5-20251001
# ROUTING_SONNET_MODEL=claude-sonnet-4-5-20250929
# ROUTING_OPUS_MODEL=claude-opus-4-6

# Scheduler for reminders and recurring messages
# ENABLE_SCHEDULER=true
# DEFAULT_TIMEZONE=UTC
